{
  "name": "video-meetings-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace apps/backend\" \"npm run dev --workspace apps/frontend\"",
    "dev:backend": "npm run dev --workspace apps/backend",
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:backend": "eslint apps/backend",
    "lint:frontend": "eslint apps/frontend",
    "format": "prettier --write \"apps/**/*.{js,mjs,cjs,ts,vue,json}\" \"*.{js,mjs,cjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/eslint-config": "^1.17.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
